{
	"extends": "$app/tsconfig",
	"compilerOptions": {
		"plugins": [
			{
				"name": "typescript-svelte-plugin"
			}
		],
		"rewriteRelativeImportExtensions": true,
		"sourceMap": true,
		"strict": true
	},
	"exclude": [
		"node_modules/**",
		"src/service-worker.js",
		"src/service-worker/**/*.js",
		"src/service-worker.ts",
		"src/service-worker/**/*.ts",
		"src/service-worker.d.ts",
		"src/service-worker/**/*.d.ts",
		"src/lib/pkg/**"
	],
	"include": ["src"]
}
